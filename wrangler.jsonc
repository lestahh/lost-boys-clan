{
  "name": "lost-boys-clan",
  "compatibility_date": "2026-07-30",
  "main": "./worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "CLAN_KV",
      "id": "893a99795f3f4a13aacedd07f7322c6a"
    }
  ],
  "triggers": {
    // keeps the Boss of the Week kill race checking the hiscores when
    // nobody has the page open, and catches the last kills of the week
    "crons": ["*/15 * * * *"]
  }
}
